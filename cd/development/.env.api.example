# .env.api.example
# Copie para .env.api em ambientes com API e UI desacopladas.

CONCILIUM__ROOT=/workspace/concilium
CONCILIUM__CONFIG_ROOT=/workspace/concilium/config

# Store operacional da API
CONCILIUM__PROJECTS_ROOT=/workspace/concilium/projetos
CONCILIUM__BENCHMARK_PROJECTS_ROOT=/workspace/concilium/benchmarks/projetos

# Bind/API
CONCILIUM__API_HOST=0.0.0.0
CONCILIUM__API_PORT=8000
CONCILIUM__API_BASE_URL=http://api:8000

# Runtime config por arquivo (opcional; se ausente usa config/concilium.yaml)
# CONCILIUM__RUNTIME_CONFIG_FILE=/workspace/concilium/config/runtime_config.json

PYTHONPATH=/workspace/concilium/src
