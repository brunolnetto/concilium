# .env.ui.example
# Copie para .env.ui em ambientes com API e UI desacopladas.

CONCILIUM__ROOT=/workspace/concilium
CONCILIUM__CONFIG_ROOT=/workspace/concilium/config

# UI não precisa escrever em store de benchmark, mas pode ler projetos via API.
CONCILIUM__PROJECTS_ROOT=/workspace/concilium/projetos

# Bind/UI
CONCILIUM__UI_HOST=0.0.0.0
CONCILIUM__UI_PORT=8501

# Endpoint da API consumida pela UI
CONCILIUM__UI_API_BASE_URL=http://api:8000
CONCILIUM__API_BASE_URL=http://api:8000

PYTHONPATH=/workspace/concilium/src
