# .env.api.example
# Copie para .env.api em ambientes com API e UI desacopladas.

CONCILIUM_ROOT=/workspace/concilium
CONCILIUM_CONFIG_ROOT=/workspace/concilium/config

# Store operacional da API
CONCILIUM_PROJECTS_ROOT=/workspace/concilium/projetos
CONCILIUM_BENCHMARK_PROJECTS_ROOT=/workspace/concilium/benchmarks/projetos

# Bind/API
CONCILIUM_API_HOST=0.0.0.0
CONCILIUM_API_PORT=8000
CONCILIUM_API_BASE_URL=http://api:8000

# Runtime config por arquivo (opcional; se ausente usa config/concilium.yaml)
# CONCILIUM_RUNTIME_CONFIG_FILE=/workspace/concilium/config/runtime_config.json

PYTHONPATH=/workspace/concilium/src
