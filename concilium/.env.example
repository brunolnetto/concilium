# .env.example — variáveis de ambiente do Concilium
#
# Copie este arquivo para .env e ajuste os valores para seu ambiente.
# Nenhuma variável é obrigatória; o sistema resolve paths automaticamente
# a partir do diretório de trabalho. Use estas variáveis para apontar para
# instalações não-padrão ou para configuração em CI/CD e containers.
#
# ATENÇÃO: nunca versione o arquivo .env — ele já está no .gitignore.

# ── Diretórios de instalação ──────────────────────────────────────────────────

# Raiz do workspace do Concilium (onde estão pyproject.toml, config/, benchmarks/).
# Útil quando o CLI é invocado de um diretório fora do projeto.
# Default: auto-detectado subindo a árvore de diretórios até encontrar pyproject.toml.
# CONCILIUM_ROOT=/caminho/para/concilium

# Raiz do diretório de configuração (config/).
# Permite apontar para um config/ externo sem alterar o workspace.
# Default: $CONCILIUM_ROOT/config
# CONCILIUM_CONFIG_ROOT=/caminho/para/config

# Arquivo de configuração de runtime (preferencial para deploy): aceita .yaml/.yml, .json ou .toml.
# Quando definido, substitui o fallback em $CONCILIUM_CONFIG_ROOT/concilium.yaml.
# CONCILIUM_RUNTIME_CONFIG_FILE=/caminho/para/runtime_config.json
#
# Alias legado (compatibilidade):
# CONCILIUM_CONFIG_FILE=/caminho/para/runtime_config.json

# Diretórios de store por ambiente (evita hardcode de caminhos em config/benchmarks/projetos).
# Default de projetos operacionais: $CONCILIUM_ROOT/projetos
# Default de projetos de benchmark: $CONCILIUM_ROOT/benchmarks/projetos
# Backend de persistência: local_json | sharepoint | s3 (filesystem é alias de local_json).
# Default: filesystem
# CONCILIUM_STORE_BACKEND=local_json
# CONCILIUM_PROJECTS_ROOT=/dados/concilium/projetos
# CONCILIUM_BENCHMARK_PROJECTS_ROOT=/dados/concilium/benchmarks_projetos

# Prefixo lógico dos projetos no backend blob (sharepoint/s3).
# CONCILIUM_STORE_PROJECTS_PREFIX=projetos

# SharePoint backend (quando CONCILIUM_STORE_BACKEND=sharepoint)
# CONCILIUM_SP_DRIVE_ID=
# CONCILIUM_SP_ROOT_PATH=Concilium/producao
# CONCILIUM_SP_TENANT_ID=
# CONCILIUM_SP_CLIENT_ID=
# CONCILIUM_SP_CLIENT_SECRET=
# CONCILIUM_SP_CACHE_DIR=.cache/sharepoint

# S3 backend com aioboto3 (quando CONCILIUM_STORE_BACKEND=s3)
# CONCILIUM_S3_BUCKET=
# CONCILIUM_S3_REGION=us-east-1
# CONCILIUM_S3_ROOT_PREFIX=concilium
# CONCILIUM_S3_ENDPOINT_URL=
# CONCILIUM_S3_ADDRESSING_STYLE=virtual
# CONCILIUM_S3_ACCESS_KEY_ID=
# CONCILIUM_S3_SECRET_ACCESS_KEY=
# CONCILIUM_S3_SESSION_TOKEN=
# CONCILIUM_S3_SERVER_SIDE_ENCRYPTION=AES256

# Caminho absoluto para o arquivo JSON de regras de mapeamento de EAP -> CPU
# usado nos utilitários de benchmark (não é obrigatório no pipeline de projeto).
# Default: $CONCILIUM_CONFIG_ROOT/referencias/cpu_mapping_rules.json
# CONCILIUM_BENCHMARK_CPU_MAPPING_RULES_FILE=/caminho/para/cpu_mapping_rules.json
#
# Compatibilidade legado (evite em novos ambientes; manter apenas durante migração):
# CONCILIUM_CPU_MAPPING_RULES_FILE=/caminho/para/cpu_mapping_rules.json

# ── Rede/API/UI (preparação para deploy desacoplado) ─────────────────────────

# Endereço de bind da API (quando executada em processo/container dedicado).
# Default atual do app API: 127.0.0.1:8000
# CONCILIUM_API_HOST=127.0.0.1
# CONCILIUM_API_PORT=8000

# URL base canônica da API para consumidores externos (UI, scripts, integrações).
# Se definida, deve incluir esquema e porta.
# Ex.: http://api.concilium.local:8000
# CONCILIUM_API_BASE_URL=http://127.0.0.1:8000

# Endereço de bind da UI (Streamlit) para cenário separado de API.
# Default comum de Streamlit: 127.0.0.1:8501
# CONCILIUM_UI_HOST=127.0.0.1
# CONCILIUM_UI_PORT=8501

# URL da API consumida pela UI (override explícito para ambiente multi-serviço).
# Ex.: http://api:8000 em docker-compose
# CONCILIUM_UI_API_BASE_URL=http://127.0.0.1:8000

# Override granular de chaves da configuração de runtime (sem editar arquivo).
# Convenção: CONCILIUM_CFG__secao__subsecao__chave=valor
# Exemplo: CONCILIUM_CFG__progress__spi__ahead_threshold=1.1

# ── Comportamento operacional (opcionais) ─────────────────────────────────────

# Tempo em segundos durante o qual mutações de catálogo são bloqueadas em
# projetos com pipeline em execução ativa. Default: 86400 (24 horas).
# CONCILIUM_LOCK_TTL_SECONDS=86400
