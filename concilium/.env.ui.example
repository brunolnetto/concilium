# .env.ui.example
# Copie para .env.ui em ambientes com API e UI desacopladas.

CONCILIUM_ROOT=/workspace/concilium
CONCILIUM_CONFIG_ROOT=/workspace/concilium/config

# UI não precisa escrever em store de benchmark, mas pode ler projetos via API.
CONCILIUM_PROJECTS_ROOT=/workspace/concilium/projetos

# Bind/UI
CONCILIUM_UI_HOST=0.0.0.0
CONCILIUM_UI_PORT=8501

# Endpoint da API consumida pela UI
CONCILIUM_UI_API_BASE_URL=http://api:8000
CONCILIUM_API_BASE_URL=http://api:8000

PYTHONPATH=/workspace/concilium/src
