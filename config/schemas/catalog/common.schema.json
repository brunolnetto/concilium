{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concilium.local/schemas/catalog/common.schema.json",
  "title": "Concilium Catalog Common Types",
  "$defs": {
    "codigoCpu": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{4,40}$"
    },
    "codigoInsumo": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{3,40}$"
    },
    "categoriaCpu": {
      "type": "string",
      "enum": [
        "TERRAPLENAGEM",
        "PAVIMENTACAO",
        "DRENAGEM",
        "SANEAMENTO",
        "OBRAS_ARTE",
        "DIVERSOS",
        "CANTEIRO",
        "MEIO_AMBIENTE",
        "DESMATAMENTO",
        "FERROVIA",
        "INFRAESTRUTURA",
        "MINERACAO"
      ]
    },
    "categoriaCusto": {
      "type": "string",
      "enum": ["MATERIAL", "DIESEL", "MAO_OBRA", "EQUIPAMENTO"]
    },
    "tipoInsumo": {
      "type": "string",
      "enum": ["MATERIAL", "MAO_OBRA", "EQUIPAMENTO", "TERCEIRIZADO"]
    },
    "fontePreco": {
      "description": "Fonte do preço. Valores canônicos: catalogo_proprio, tabela_referencia, cotacao_mercado, negociado. Aceita strings livres para referências externas (ex: PLANILHA_AGIS_2026_05, SICRO_DNIT).",
      "type": "string",
      "minLength": 1
    },
    "origemCpu": {
      "type": "string",
      "enum": ["REFERENCIA", "PROPRIA"]
    },
    "composicaoItem": {
      "description": "Item da composição de uma CPU. unidade é derivada de Insumo.unidade — não armazenar aqui. Unicidade por insumo_id deve ser garantida pela aplicação.",
      "type": "object",
      "additionalProperties": false,
      "required": ["insumo_id", "coeficiente", "categoria_custo"],
      "properties": {
        "insumo_id": {
          "$ref": "#/$defs/codigoInsumo"
        },
        "coeficiente": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "categoria_custo": {
          "$ref": "#/$defs/categoriaCusto"
        }
      }
    },
    "funcaoEquipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funcao_id", "num_pessoas"],
      "properties": {
        "funcao_id": {
          "$ref": "#/$defs/codigoInsumo"
        },
        "num_pessoas": {
          "type": "integer",
          "minimum": 1
        },
        "horas_extras_pct": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "papel": {
          "type": "string",
          "enum": ["direto", "indireto", "gestao"],
          "default": "direto"
        },
        "custo_mobilizacao": {
          "description": "Custo de mobilização por pessoa desta função (ADR-106 F2-bis / ADR-137 P2).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "custo_desmobilizacao": {
          "description": "Custo de desmobilização por pessoa desta função (ADR-106 F2-bis / ADR-137 P2).",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "equipamentoEquipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["equip_id", "num_unidades"],
      "properties": {
        "equip_id": {
          "$ref": "#/$defs/codigoInsumo"
        },
        "num_unidades": {
          "type": "integer",
          "minimum": 1
        },
        "consumo_litros_hora_estimado": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "consumo_litros_hora": {
          "description": "Consumo de diesel por hora para este item da composição — sobrepõe Insumo.atributos_especificos.consumo_litros_hora (ver pu_calculator._consumo_diesel_equipamento).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "preco_h_unitario": {
          "description": "Preço por hora deste equipamento nesta composição — sobrepõe Insumo.preco_unitario, permitindo preço por-atividade sem duplicar insumos no catálogo (ADR-132).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "custo_mobilizacao": {
          "description": "Custo de mobilização por unidade deste equipamento (ADR-106 F2-bis / ADR-137 P2).",
          "type": ["number", "null"],
          "minimum": 0
        },
        "custo_desmobilizacao": {
          "description": "Custo de desmobilização por unidade deste equipamento (ADR-106 F2-bis / ADR-137 P2).",
          "type": ["number", "null"],
          "minimum": 0
        }
      }
    },
    "materialEquipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["insumo_id", "consumo_por_hora", "unidade"],
      "properties": {
        "insumo_id": {
          "$ref": "#/$defs/codigoInsumo"
        },
        "consumo_por_hora": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unidade": {
          "type": "string"
        },
        "descricao": {
          "type": ["string", "null"]
        },
        "origem_entrada": {
          "description": "Proveniência da entrada (ADR-139 D2, resolve ADR-138 §D7): consumo_operacional = consumo por hora de operação (ADR-030 D2); bom_convertido = BOM por unidade de produto convertido via coeficiente × valor_horario (ADR-138 F2). null = não classificado.",
          "type": ["string", "null"],
          "enum": ["consumo_operacional", "bom_convertido", null]
        }
      }
    },
    "materialGerado": {
      "description": "Material gerado por hora de operação da equipe — lado produtor do padrão produtor-consumidor (ADR-139 D3). insumo_id deve referenciar Insumo com origem_material=GERACAO_INTERNA (VAL-PROD-GERACAO-01).",
      "type": "object",
      "additionalProperties": false,
      "required": ["insumo_id", "geracao_por_hora", "unidade"],
      "properties": {
        "insumo_id": {
          "$ref": "#/$defs/codigoInsumo"
        },
        "geracao_por_hora": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unidade": {
          "type": "string"
        },
        "descricao": {
          "type": ["string", "null"]
        }
      }
    },
    "disponibilidadeConsumivel": {
      "description": "Estoque/capacidade/reabastecimento de recurso consumível (ADR-128 D1; ADR-139 D4 usa capacidade_armazenamento como pilha/bota-espera de material gerado). Ausência do objeto = disponibilidade irrestrita.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "capacidade_armazenamento": {"type": ["number", "null"], "minimum": 0},
        "estoque_inicial": {"type": "number", "minimum": 0, "default": 0.0},
        "taxa_reabastecimento_max": {"type": ["number", "null"], "minimum": 0},
        "lead_time_reabastecimento_dias": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "composicaoPadraoEquipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["funcoes", "equipamentos"],
      "properties": {
        "funcoes": {
          "type": "array",
          "items": { "$ref": "#/$defs/funcaoEquipe" },
          "uniqueItems": true
        },
        "equipamentos": {
          "type": "array",
          "items": { "$ref": "#/$defs/equipamentoEquipe" },
          "uniqueItems": true
        },
        "materiais": {
          "type": "array",
          "items": { "$ref": "#/$defs/materialEquipe" },
          "uniqueItems": true,
          "default": []
        }
      }
    },
    "decomposicaoEquip": {
      "description": "Decomposição do custo horário do equipamento em componentes. custo_hora_total = mao_obra_h + diesel_h + material_h + capital_h — calculado em runtime, não armazenar.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "custo_mao_obra_h",
        "custo_diesel_h",
        "custo_material_h",
        "custo_capital_h"
      ],
      "properties": {
        "custo_mao_obra_h": {"type": "number", "minimum": 0},
        "custo_diesel_h": {"type": "number", "minimum": 0},
        "custo_material_h": {"type": "number", "minimum": 0},
        "custo_capital_h": {"type": "number", "minimum": 0}
      }
    },
    "relacaoSinergia": {
      "description": "Aresta do grafo de sinergia intra-equipe (ADR-130 D1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["tipo", "origem", "destino"],
      "properties": {
        "tipo": {
          "type": "string",
          "enum": ["acoplamento", "dimensionamento", "precondicao"]
        },
        "origem": {"type": "string"},
        "destino": {"type": "string"},
        "razao": {"type": ["number", "null"]},
        "descricao": {"type": ["string", "null"]}
      }
    },
    "capacidadeElemento": {
      "description": "Parâmetro de capacidade de um elemento da composição (ADR-130 D1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["elemento_id", "capacidade_horaria", "unidade"],
      "properties": {
        "elemento_id": {"type": "string"},
        "capacidade_horaria": {
          "description": "Capacidade produtiva do elemento na unidade de produção da CPU (ex.: m³/h).",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unidade": {"type": "string"},
        "fonte": {
          "type": "string",
          "enum": ["catalogo", "fabricante", "medicao_obra"],
          "default": "catalogo"
        },
        "justificativa": {
          "description": "Memória de cálculo/rationale por trás de capacidade_horaria (fórmula, premissas, especificação consultada) — ver ADR-130 F4.",
          "type": ["string", "null"]
        }
      }
    },
    "grafoSinergiaEquipe": {
      "description": "Estrutura de sinergia da equipe: relações + capacidades. Opcional por CPU (ADR-130 D1).",
      "type": "object",
      "additionalProperties": false,
      "required": ["relacoes", "capacidades"],
      "properties": {
        "relacoes": {
          "type": "array",
          "items": {"$ref": "#/$defs/relacaoSinergia"},
          "uniqueItems": true,
          "default": []
        },
        "capacidades": {
          "type": "array",
          "items": {"$ref": "#/$defs/capacidadeElemento"},
          "uniqueItems": true,
          "default": []
        },
        "gargalo_declarado": {"type": ["string", "null"]}
      }
    }
  }
}
