{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concilium.local/schemas/catalog/cpu.schema.json",
  "title": "CPU (ADR-053)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": {"^_": {"type": ["string", "number", "null"]}},
  "required": [
    "codigo",
    "descricao",
    "unidade",
    "origem",
    "producao_id_ref",
    "categoria",
    "composicao_itens"
  ],
  "properties": {
    "codigo": {
      "$ref": "common.schema.json#/$defs/codigoCpu"
    },
    "descricao": {
      "type": "string",
      "minLength": 1
    },
    "unidade": {
      "type": "string",
      "minLength": 1
    },
    "origem": {
      "$ref": "common.schema.json#/$defs/origemCpu"
    },
    "cpu_referencia_id": {
      "type": ["string", "null"]
    },
    "producao_id_ref": {
      "type": "string",
      "pattern": "^[A-Z0-9-]{3,80}$"
    },
    "categoria": {
      "$ref": "common.schema.json#/$defs/categoriaCpu"
    },
    "composicao_itens": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/composicaoItem" },
      "uniqueItems": true
    },
    "atributos_categoria": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "dmt_min_metros": {"type": ["number", "null"], "minimum": 0},
        "dmt_max_metros": {"type": ["number", "null"]},
        "dmt_referencia_m": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "cpus_alternativos": {
      "description": "Lista de codigo de CPUs alternativos usados em análise de campanha (application/services/campaign/campaign_service).",
      "type": "array",
      "items": {"type": "string"}
    },
    "grupo_servico": {
      "description": "Categoria de agrupamento de serviço para relatórios/organização (ex.: 'TERRA-ESCO-CARGA-1CAT').",
      "type": ["string", "null"]
    },
    "custo_direto_unitario_planilha": {
      "description": "Custo direto unitário extraído da planilha de referência (modo planilha-first, ADR-050). Somente leitura.",
      "type": ["number", "null"],
      "minimum": 0
    },
    "precos_unitarios_sbdi": {
      "description": "Decomposição do PU por categoria de custo com BDI separado (planilha-first). Chaves: material, mao_obra, diesel, equipamentos.",
      "type": ["object", "null"],
      "additionalProperties": {"type": ["number", "null"]}
    },
    "_cu_planilha": {
      "type": ["number", "null"]
    }
  }
}
