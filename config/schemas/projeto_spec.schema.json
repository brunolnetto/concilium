{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concilium.local/schemas/projeto_spec.schema.json",
  "title": "ProjetoSpec",
  "description": "Spec unificado de criação de projeto — análogo ao referencia.json de benchmark.",
  "type": "object",
  "additionalProperties": false,
  "required": ["meta", "escopos"],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nome", "contexto_id", "tipo_obra", "localizacao", "coordenadas", "data_inicio", "data_termino"],
      "properties": {
        "nome": { "type": "string", "minLength": 1 },
        "contexto_id": { "type": "string", "minLength": 1 },
        "tipo_obra": {
          "type": "string",
          "enum": ["terraplenagem", "pavimentacao", "saneamento", "drenagem", "obras_arte", "diversos"]
        },
        "localizacao": { "type": "string", "minLength": 1, "description": "Cidade, UF (ex: Aracoiaba, CE)" },
        "coordenadas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lng"],
          "properties": {
            "lat": { "type": "number", "minimum": -90, "maximum": 90 },
            "lng": { "type": "number", "minimum": -180, "maximum": 180 }
          }
        },
        "data_inicio": { "type": "string", "format": "date" },
        "data_termino": { "type": "string", "format": "date" },
        "regime_trabalho": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "dias_semana": { "type": "integer", "minimum": 1, "maximum": 7, "default": 6 },
            "horas_dia": { "type": "integer", "minimum": 1, "maximum": 24, "default": 8 }
          }
        },
        "regime_tributario": {
          "description": "Alíquotas BDI por componente. Se omitido, deriva da jurisdição do contexto.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdicao_id": {
              "type": "string",
              "description": "Código IBGE/ISO da jurisdição (ex: BR-CE). Usado para derivar alíquotas padrão."
            },
            "iss":   { "type": "number", "minimum": 0, "maximum": 1 },
            "pis":   { "type": "number", "minimum": 0, "maximum": 1 },
            "cofins":{ "type": "number", "minimum": 0, "maximum": 1 },
            "cprb":  { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "escopos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["escopo_id", "nome", "eap"],
        "properties": {
          "escopo_id": { "type": "string", "minLength": 1 },
          "nome": { "type": "string", "minLength": 1 },
          "eap": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id", "cpu_id", "quantitativo"],
              "properties": {
                "item_id": { "type": "string", "minLength": 1 },
                "cpu_id": { "type": "string", "minLength": 1 },
                "quantitativo": { "type": "number", "exclusiveMinimum": 0 },
                "predecessores": {
                  "type": "array",
                  "default": [],
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["item_id"],
                    "properties": {
                      "item_id": { "type": "string" },
                      "tipo": { "type": "string", "enum": ["FS", "SS", "FF"], "default": "FS" },
                      "lag": { "type": "integer", "minimum": 0, "default": 0 },
                      "completion_threshold_pct": {
                        "type": "number", "minimum": 0, "maximum": 1, "default": 1.0
                      }
                    }
                  }
                }
              }
            }
          },
          "cronograma": {
            "description": "Intenção de cronograma por item. Se omitido, skill 04 usa AUTO_SCHEDULE.",
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["item_id"],
              "properties": {
                "item_id": { "type": "string" },
                "n_equipes": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "n_inicial": { "type": "integer", "minimum": 1, "default": 1 },
                    "n_max":     { "type": "integer", "minimum": 1, "default": 1 }
                  }
                },
                "producao_diaria": { "type": "number", "exclusiveMinimum": 0 }
              }
            }
          }
        }
      }
    }
  }
}
