{
  "$schema": "https://concilium.framework/schemas/v1/template_planilha",
  "$comment": "Template genérico para geração de planilhas de orçamento auditável. Define a estrutura de abas e mapeamento canônico → células. Independente de construtora/perfil.",
  "id": "planilha_planejamento_v1",
  "versao": "1.0.0",
  "nome": "Template de Planejamento e Orçamento",
  "descricao": "Estrutura genérica para planilha de cenário com três seções: Planejamento (EAP), Equipes (ponto de equilíbrio), Resultado financeiro",
  "gerado_em": "2026-04-28",
  
  "abas": {
    "PRATICABILIDADE": {
      "ordem": 1,
      "descricao": "Dados de praticabilidade climática e produtividade mensal",
      "secoes": [
        {
          "nome": "Produtividade Mensal",
          "linhas": [13, 14, 15, 16],
          "colunas": "C:N",
          "origem_canonico": "projeto.praticabilidade.percentual_produtivo_mensal",
          "validacao": "valores entre 0.0 e 1.0; 12 meses"
        }
      ]
    },
    
    "CRONOGRAMA": {
      "ordem": 2,
      "descricao": "Sequenciamento de atividades da EAP com duração e recursos",
      "secoes": [
        {
          "nome": "Itens da EAP",
          "repeticao": "por item da EAP",
          "template_linhas": [17, 18, 19, 20, 21, 22, 23, 24],
          "colunas": "B:N",
          "mapeamento": {
            "item_id": "coluna B",
            "descricao": "coluna C",
            "unidade": "coluna D",
            "quantitativo": "coluna E",
            "producao_horaria": "coluna F",
            "dias_trabalhados": "coluna J",
            "num_equipes": "colunas K:V (jan-dez)",
            "percentual_executado_acumulado": "coluna W"
          },
          "origem_canonico": "planejamento[*]"
        }
      ]
    },
    
    "EQUIPE": {
      "ordem": 3,
      "descricao": "Composição, custos e alocação de equipes diretas",
      "secoes": [
        {
          "nome": "Equipes Diretas",
          "repeticao": "por equipe",
          "template_linhas": [17, 18, 19, 20, 21, 28, 29, 30],
          "colunas": "E:U",
          "mapeamento": {
            "equipe_id": "coluna E",
            "funcoes": "linhas 17-21",
            "num_pessoas_por_funcao": "coluna G",
            "custo_unitario": "coluna H",
            "permanencia_meses": "coluna K",
            "custo_fixo_total": "coluna U",
            "custo_venda_cpu": "coluna R",
            "delta_pct_equilibrio": "coluna S"
          },
          "origem_canonico": "equipes_diretas[*]"
        }
      ]
    },
    
    "PLANEJAMENTO": {
      "ordem": 4,
      "descricao": "Orçamento por item EAP: preços unitários, BDI, subtotais",
      "secoes": [
        {
          "nome": "Itens de Orçamento",
          "repeticao": "por item planejamento",
          "template_linhas": [55, 56, 57, 58, 59],
          "colunas": "B:J",
          "mapeamento": {
            "item_id": "coluna B",
            "cpu_id": "coluna C",
            "descricao": "coluna D",
            "unidade": "coluna E",
            "quantitativo": "coluna F",
            "preco_unitario.material": "coluna G",
            "preco_unitario.diesel": "coluna H",
            "preco_unitario.equipamentos": "coluna I",
            "bdi.material": "coluna J",
            "bdi.diesel": "coluna K",
            "bdi.equipamentos": "coluna L",
            "subtotal.sem_bdi.total": "coluna R",
            "subtotal.com_bdi.total": "coluna S"
          },
          "origem_canonico": "planejamento[*]",
          "validacao": "preços > 0; BDI em faixa de perfil"
        }
      ]
    },
    
    "ADM": {
      "ordem": 5,
      "descricao": "Custos indiretos de Administração de obra",
      "categoria_indireto": "ADM",
      "secoes": [
        {
          "nome": "Verbas Mensais",
          "linhas": [55, 56, 57, 58, 59, 60, 61, 62, 63, 64, 65, 66, 77],
          "colunas": "C:N",
          "origem_canonico": "indiretos[?categoria=='ADM'].custo_mensal"
        },
        {
          "nome": "Verbas Fixas",
          "linhas": [80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94],
          "colunas": "C:D",
          "origem_canonico": "indiretos[?categoria=='ADM'].custo_fixo"
        }
      ]
    },
    
    "TOP": {
      "ordem": 6,
      "descricao": "Custos indiretos de Topografia",
      "categoria_indireto": "TOP",
      "secoes": [
        {
          "nome": "Verbas Mensais",
          "linhas": [55, 56, 57, 58, 59, 60, 61, 62, 63, 64, 65, 66, 77],
          "colunas": "C:N",
          "origem_canonico": "indiretos[?categoria=='TOP'].custo_mensal"
        },
        {
          "nome": "Verbas Fixas",
          "linhas": [80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94],
          "colunas": "C:D",
          "origem_canonico": "indiretos[?categoria=='TOP'].custo_fixo"
        }
      ]
    },
    
    "LAB": {
      "ordem": 7,
      "descricao": "Custos indiretos de Laboratório",
      "categoria_indireto": "LAB",
      "secoes": [
        {
          "nome": "Verbas Mensais",
          "linhas": [55, 56, 57, 58, 59, 60, 61, 62, 63, 64, 65, 66, 77],
          "colunas": "C:N",
          "origem_canonico": "indiretos[?categoria=='LAB'].custo_mensal"
        },
        {
          "nome": "Verbas Fixas",
          "linhas": [80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94],
          "colunas": "C:D",
          "origem_canonico": "indiretos[?categoria=='LAB'].custo_fixo"
        }
      ]
    },
    
    "QSMS": {
      "ordem": 8,
      "descricao": "Custos indiretos de Qualidade, Saúde, Segurança e Meio Ambiente",
      "categoria_indireto": "QSMS",
      "secoes": [
        {
          "nome": "Verbas Mensais",
          "linhas": [55, 56, 57, 58, 59, 60, 61, 62, 63, 64, 65, 66, 77],
          "colunas": "C:N",
          "origem_canonico": "indiretos[?categoria=='QSMS'].custo_mensal"
        },
        {
          "nome": "Verbas Fixas",
          "linhas": [80, 81, 82, 83, 84, 85, 86, 87, 88, 89, 90, 91, 92, 93, 94],
          "colunas": "C:D",
          "origem_canonico": "indiretos[?categoria=='QSMS'].custo_fixo"
        }
      ]
    },
    
    "MOB": {
      "ordem": 9,
      "descricao": "Custos de Mobilização e Desmobilização",
      "categoria_indireto": "MOB",
      "secoes": [
        {
          "nome": "Mobilização e Desmobilização",
          "linhas": [17, 18, 19, 20],
          "colunas": "B:D",
          "origem_canonico": "indiretos[?categoria=='MOB']"
        },
        {
          "nome": "Equipe Direta",
          "linhas": [32, 33, 34, 35, 36, 37],
          "colunas": "B:F",
          "origem_canonico": "indiretos[?categoria=='MOB'].equipes"
        }
      ]
    },
    
    "CPU": {
      "ordem": 10,
      "descricao": "Composições de preços unitários (referência para auditoria)",
      "secoes": [
        {
          "nome": "CPUs Utilizadas",
          "repeticao": "por CPU referenciada",
          "colunas": "A:E",
          "origem_canonico": "planejamento[*].cpu_id"
        }
      ]
    },
    
    "RESULTADO": {
      "ordem": 11,
      "descricao": "Síntese financeira e indicadores de viabilidade",
      "secoes": [
        {
          "nome": "Financeiro",
          "linhas": [28, 29, 30, 31],
          "colunas": "B:C",
          "mapeamento": {
            "preco_venda_total": "linha 28, coluna C",
            "custo_total": "linha 29, coluna C",
            "resultado_bruto": "linha 30, coluna C",
            "margem_pct": "linha 31, coluna C"
          },
          "origem_canonico": "resultado"
        },
        {
          "nome": "Status de Viabilidade",
          "linhas": [32],
          "colunas": "B:C",
          "mapeamento": {
            "status_margem": "coluna B (cor: verde/amarelo/vermelho)",
            "status_equilibrio": "coluna C"
          },
          "origem_canonico": "resultado.status_margem; resultado.validacoes[*]"
        },
        {
          "nome": "Indiretos",
          "linhas": [35, 36],
          "colunas": "B:C",
          "mapeamento": {
            "custo_indireto": "linha 35, coluna C",
            "razao_indireto_direto": "linha 36, coluna C"
          },
          "origem_canonico": "resultado.custo.indireto; resultado"
        }
      ]
    }
  },
  
  "regras_globais": {
    "preservar_formulas": true,
    "preservar_macros": true,
    "preserve_formatacao": true,
    "cálculo_automático": "Excel ao abrir",
    "nota_importante": "Adapter popula apenas células de entrada (preços, quantidades, equipes). Fórmulas existentes no template calculam agregações e indicadores."
  },
  
  "validacoes": [
    {
      "codigo": "VAL-TEMPLATE-01",
      "nivel": "ERRO",
      "descricao": "Canônico passou em todas as validações estruturais"
    },
    {
      "codigo": "VAL-TEMPLATE-02",
      "nivel": "AVISO",
      "descricao": "Validações de política diferente de OK (renderiza com marcação)"
    },
    {
      "codigo": "VAL-TEMPLATE-03",
      "nivel": "AVISO",
      "descricao": "Alguma seção do template está vazia"
    }
  ],
  
  "notas_implementacao": [
    "Template é agnóstico a construtora — parametrizado via skill.toml",
    "Mapa de células é declarativo: facilita migração de estrutura Excel",
    "Adapter skill 07 interpreta este JSON e popula o arquivo .xlsm de saída",
    "Se template Excel mudar estrutura, atualizar apenas este JSON, não a skill",
    "Referências canônico usam JMESPath para extrair valores aninhados"
  ]
}
