{% extends "_base.html.jinja2" %}
{% block title %}{{ heading }}{% endblock %}
{% block content %}
<h1 style="font-size:18px;margin:0 0 16px;">{{ heading }}</h1>
{% if intro %}
<p style="font-size:14px;line-height:1.5;margin:0 0 16px;">{{ intro }}</p>
{% endif %}
{% if details %}
<table role="presentation" cellpadding="0" cellspacing="0" style="width:100%;font-size:14px;margin:0 0 16px;">
{% for key, value in details %}
<tr>
<td style="padding:4px 0;color:#6b7280;">{{ key }}</td>
<td style="padding:4px 0;font-weight:bold;">{{ value }}</td>
</tr>
{% endfor %}
</table>
{% endif %}
<p style="font-size:14px;line-height:1.5;margin:0 0 8px;">Em anexo: <code>concilium_usage_tutorial.skill</code> → tutorial de instalação e uso.</p>
{% if download_note %}
<p style="font-size:13px;line-height:1.5;color:#374151;white-space:pre-wrap;overflow-wrap:break-word;word-break:break-all;">{{ download_note }}</p>
{% endif %}
<p style="font-size:14px;line-height:1.5;margin:16px 0 4px;">Código de ativação (cole no campo pedido durante a instalação):</p>
<p style="font-size:16px;font-weight:bold;font-family:monospace;margin:0;">{{ client_code }}</p>
{% endblock %}
