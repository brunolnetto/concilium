{
  "manifest_version": "0.3",
  "name": "concilium-mcp-proxy",
  "version": "1.0.0",
  "display_name": "Concilium",
  "description": "Ponte MCP para o Concilium (MendesLobo Construtora) — ativação automática de dispositivo via client_code.",
  "author": {
    "name": "MendesLobo Construtora"
  },
  "server": {
    "type": "binary",
    "entry_point": "server/concilium-mcp-proxy-linux",
    "mcp_config": {
      "command": "server/concilium-mcp-proxy-linux",
      "env": {
        "CONCILIUM_SERVER_URL": "https://mcp.mendesloboconstrucao.com.br",
        "CONCILIUM_CLIENT_CODE": "${user_config.concilium_client_code}"
      },
      "platform_overrides": {
        "win32": {
          "command": "server/concilium-mcp-proxy.exe"
        },
        "darwin": {
          "command": "server/concilium-mcp-proxy-macos"
        },
        "linux": {
          "command": "server/concilium-mcp-proxy-linux"
        }
      }
    }
  },
  "user_config": {
    "concilium_client_code": {
      "type": "string",
      "title": "Código de ativação",
      "description": "Código de ativação do seu dispositivo (RCODE-...), enviado por e-mail no cadastro.",
      "required": true,
      "sensitive": true
    }
  }
}
